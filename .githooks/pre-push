#!/usr/bin/env python3
"""Reject private manuscript paths throughout every commit being pushed."""
from pathlib import PurePosixPath
import subprocess
import sys

seen=set()
private_names={'main.tex','supplement.tex','references.bib','km_reconstruction.pdf','supplement.pdf'}
for line in sys.stdin:
    local_ref,local_sha,remote_ref,remote_sha=line.split()
    if set(local_sha)=={'0'}:
        continue
    for commit in subprocess.check_output(['git','rev-list',local_sha],text=True).splitlines():
        if commit in seen:
            continue
        seen.add(commit)
        paths=subprocess.check_output(['git','ls-tree','-r','--name-only','-z',commit],text=True).split('\0')
        for name in filter(None,paths):
            path=PurePosixPath(name)
            if (path.parts[0].lower() in {'manuscript','paper_context','claude outputs'}
                    or path.name.lower() in private_names or path.suffix.lower()=='.docx'):
                sys.exit('Push blocked: unpublished manuscript path in history: '+name)
